# Neon/Vercel server-side connection string. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Random secret used by the notification scheduler.
CRON_SECRET=
